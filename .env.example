APP_ENV=local
HOST=127.0.0.1
PORT=8000

AI_ENABLED=false
AI_ZERO_COST_MODE=true

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

AI_REQUEST_TIMEOUT_SECONDS=15
AI_MAX_RETRIES=1
AI_CACHE_ENABLED=true
AI_DAILY_REQUEST_LIMIT=45

# Public/cloud mode enforces stricter ceilings; single worker only.
MAX_UPLOAD_MB=25
MAX_ROWS=50000
MAX_COLUMNS=100
MAX_SESSIONS=50
MAX_VERSIONS=30
MAX_STORAGE_MB=512
SESSION_TTL_MINUTES=60
JOB_TIMEOUT_SECONDS=120
# STORAGE_ROOT defaults to the project's private storage directory.
